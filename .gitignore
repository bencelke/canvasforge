# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
/MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# uv / tooling
.uv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.nox/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets and credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.cac
*.cookie
*.tokens
credentials.json
secrets.json
auth.json
*.msapp

# Power Platform / solution packages (never commit tenant artifacts)
*.zip
!schemas/**/*.zip
solutions/

# CanvasForge Deployment Kits and extracted contents
*.cforge.zip
kits/
deployment-kits/
kit-out/
extracted/
unpacked-kit/

# Incoming / local evidence (sanitized fixtures may be added deliberately)
evidence/incoming/
evidence/runtime/
**/sanitized-runtime-reports/

# Generated output (inspectable locally; not committed by default)
generated/**
!generated/.gitkeep

# Local preview (future React/Vite) caches and build output
preview/.cache/
preview/dist/
preview/node_modules/
**/.vite/
local-preview-cache/

# Local screenshots and capture folders
screenshots/
local-screenshots/
**/studio-captures/

# Local scratch
*.log
tmp/
temp/
.cache/

# Explicit kit artifacts (also covered by *.zip / dist/)
*.cforge.zip
*.cforge-evidence.zip
